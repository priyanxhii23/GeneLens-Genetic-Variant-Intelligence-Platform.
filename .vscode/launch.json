{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GeneLens API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "Run pipeline for HBB (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_pipeline",
      "args": ["--gene", "HBB"],
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
