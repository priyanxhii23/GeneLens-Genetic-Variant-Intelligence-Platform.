# Copy to backend/.env and edit. Every setting is optional.
# Values here are read ONLY by the backend – they are never sent to the browser.

# Where GeneLens stores its database, caches, downloads, reports and exports.
# GENELENS_DATA_DIR=./data

# Use PostgreSQL instead of SQLite (requires `pip install psycopg[binary]`):
# GENELENS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/genelens

# Optional NCBI API key: raises the E-utilities limit from 3 to 10 requests/second.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
# GENELENS_NCBI_API_KEY=
# GENELENS_NCBI_EMAIL=

# Default gnomAD dataset and HTTP behaviour
# GENELENS_GNOMAD_DEFAULT_DATASET=gnomad_r4
# GENELENS_HTTP_TIMEOUT_SECONDS=60
# GENELENS_CACHE_TTL_HOURS=168

# GENELENS_LOG_LEVEL=INFO
